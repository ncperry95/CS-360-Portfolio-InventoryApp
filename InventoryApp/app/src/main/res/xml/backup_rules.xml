<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules for Android 11 and lower. allowBackup is false in the
   manifest, so nothing is backed up on these versions. The exclusions below
   keep the database out even if backups are ever turned back on, because it
   holds every account's password hash.
-->
<full-backup-content>
    <exclude domain="database" path="inventory_app.db" />
    <exclude domain="database" path="inventory_app.db-wal" />
    <exclude domain="database" path="inventory_app.db-shm" />
    <exclude domain="database" path="inventory_app.db-journal" />
</full-backup-content>
