<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup and transfer rules for Android 12 and higher. allowBackup="false"
   stops cloud backup, but on some devices it does not stop device to device
   transfer, so the database is excluded from both explicitly. It holds every
   account's password hash and should never leave the device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="inventory_app.db" />
        <exclude domain="database" path="inventory_app.db-wal" />
        <exclude domain="database" path="inventory_app.db-shm" />
        <exclude domain="database" path="inventory_app.db-journal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="inventory_app.db" />
        <exclude domain="database" path="inventory_app.db-wal" />
        <exclude domain="database" path="inventory_app.db-shm" />
        <exclude domain="database" path="inventory_app.db-journal" />
    </device-transfer>
</data-extraction-rules>
